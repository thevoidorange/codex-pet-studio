{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pet-studio/preview-config.schema.json",
  "title": "Codex Pet Studio Previewer Configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "pet",
    "versions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deliveryTarget": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "pet": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "atlasUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "static": {
          "$ref": "#/$defs/staticStudy"
        },
        "stateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "lookDirectionsAvailable": {
          "type": "boolean"
        },
        "frameTakes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameTakeGroup"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "static"
          ]
        },
        {
          "required": [
            "atlasUrl"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "lookDirectionsAvailable"
            ],
            "properties": {
              "lookDirectionsAvailable": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "atlasUrl"
            ]
          }
        },
        {
          "if": {
            "required": [
              "stateIds"
            ],
            "properties": {
              "stateIds": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "atlasUrl"
            ]
          }
        },
        {
          "if": {
            "required": [
              "stateIds"
            ],
            "properties": {
              "stateIds": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "required": [
              "static"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "staticStudy": {
      "type": "object",
      "required": [
        "assetUrl"
      ],
      "properties": {
        "assetUrl": {
          "$ref": "#/$defs/assetUrl"
        },
        "takes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standaloneTake"
          }
        }
      },
      "additionalProperties": true
    },
    "standaloneTake": {
      "type": "object",
      "required": [
        "id",
        "assetUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "const": "original"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "assetUrl": {
          "$ref": "#/$defs/assetUrl"
        }
      },
      "additionalProperties": true
    },
    "frameTakeGroup": {
      "type": "object",
      "required": [
        "stateId",
        "frameIndex",
        "takes"
      ],
      "properties": {
        "stateId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        },
        "takes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        }
      },
      "additionalProperties": true
    },
    "take": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "const": "original"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "assetUrl": {
          "$ref": "#/$defs/assetUrl"
        },
        "atlasSlot": {
          "$ref": "#/$defs/atlasSlot"
        }
      },
      "oneOf": [
        {
          "required": [
            "assetUrl"
          ],
          "not": {
            "required": [
              "atlasSlot"
            ]
          }
        },
        {
          "required": [
            "atlasSlot"
          ],
          "not": {
            "required": [
              "assetUrl"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "assetUrl": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\./)?(?!\\.\\.(?:/|$))[A-Za-z0-9._~-]+(?:/(?!\\.\\.(?:/|$))[A-Za-z0-9._~-]+)*$"
    },
    "atlasSlot": {
      "type": "object",
      "required": [
        "row",
        "column"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
