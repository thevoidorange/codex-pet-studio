{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pet-studio/project.schema.json",
  "title": "Codex Pet Studio Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "paths",
    "privacy",
    "export"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "defaultLocale",
        "locales"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "defaultLocale": {
          "type": "string",
          "minLength": 1
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": [
        "pet",
        "previewer",
        "exports"
      ],
      "properties": {
        "pet": {
          "type": "string",
          "minLength": 1
        },
        "previewer": {
          "type": "string",
          "minLength": 1
        },
        "exports": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "privateTermsFile"
      ],
      "properties": {
        "privateTermsFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
