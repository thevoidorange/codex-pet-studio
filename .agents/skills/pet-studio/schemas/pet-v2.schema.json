{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pet-studio/pet-v2.schema.json",
  "title": "Codex Pet v2 Manifest",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "description",
    "spriteVersionNumber",
    "spritesheetPath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "spriteVersionNumber": {
      "const": 2
    },
    "spritesheetPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.(?:png|webp)$"
    }
  },
  "additionalProperties": true
}
