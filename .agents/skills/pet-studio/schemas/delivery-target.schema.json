{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pet-studio/delivery-target.schema.json",
  "title": "Codex Pet Studio Delivery Target",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "id",
    "displayName",
    "verifiedAgainst",
    "package",
    "atlas",
    "runtime",
    "states",
    "lookDirections",
    "display"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAgainst": {
      "type": "object",
      "required": [
        "authority",
        "product",
        "version",
        "build",
        "date"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "manifestFile",
        "manifestSchema",
        "spriteVersionNumber",
        "spritesheetFormats"
      ],
      "properties": {
        "manifestFile": {
          "type": "string",
          "minLength": 1
        },
        "manifestSchema": {
          "type": "string",
          "minLength": 1
        },
        "spriteVersionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "spritesheetFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "png",
              "webp"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "atlas": {
      "type": "object",
      "required": [
        "columns",
        "rows",
        "cellWidthPx",
        "cellHeightPx"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cellWidthPx": {
          "type": "integer",
          "minimum": 1
        },
        "cellHeightPx": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "owner",
        "idleStateId",
        "idleDurationMultiplier",
        "actionLoops",
        "actionReturnStateId"
      ],
      "properties": {
        "owner": {
          "const": "codex-client"
        },
        "idleStateId": {
          "type": "string",
          "minLength": 1
        },
        "idleDurationMultiplier": {
          "type": "integer",
          "minimum": 1
        },
        "actionLoops": {
          "type": "integer",
          "minimum": 1
        },
        "actionReturnStateId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "row",
          "firstColumn",
          "durationsMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "firstColumn": {
            "type": "integer",
            "minimum": 0
          },
          "durationsMs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "lookDirections": {
      "type": "object",
      "required": [
        "coordinateSystem",
        "clockwise",
        "neutralStateId",
        "slots"
      ],
      "properties": {
        "coordinateSystem": {
          "const": "screen-clockwise-from-up"
        },
        "clockwise": {
          "const": true
        },
        "neutralStateId": {
          "type": "string",
          "minLength": 1
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "degree",
              "key",
              "row",
              "column"
            ],
            "properties": {
              "degree": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "required": [
        "owner",
        "minimumPx",
        "maximumPx"
      ],
      "properties": {
        "owner": {
          "const": "codex-client-setting"
        },
        "minimumPx": {
          "type": "integer",
          "minimum": 1
        },
        "maximumPx": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
